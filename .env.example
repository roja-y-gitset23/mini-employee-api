APP_NAME=Mini Employee Directory API
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
DATA_FILE=data/employees.json

# Shared secret used to verify HMAC SHA256 webhook signatures
WEBHOOK_SECRET=change-me-to-a-long-random-string

# External API used by POST /employees/sync
EXTERNAL_API_URL=https://dummyjson.com/users?limit=30
EXTERNAL_API_TIMEOUT=10
DEFAULT_SALARY=50000

# Maximum upload size for CSV/Excel/PDF imports
MAX_UPLOAD_MB=5